# All patterns are anchored on purpose. An unanchored `lib/` would also
# swallow upstream/open-intelligent-ui/src/lib/, which is reference source.

# Dependencies
node_modules/

# Our own build output. Regenerated by `pnpm build`; committed only when
# releasing, and that is a deliberate decision recorded in session-log.md
# (AGENTS.md §7). Anchored so it cannot match a nested src/lib.
/lib/

# Scratch and generated state
/tmp/
*.tsbuildinfo
.DS_Store
Thumbs.db
.vscode/
.idea/

# The upstream snapshots are read-only sources with no VCS metadata and no
# dependency trees. Replaced wholesale on an upstream move.
upstream/*/.git/
upstream/*/node_modules/
upstream/*/.next/

# Next.js writes this on first build; it is generated, not source, and the
# upstream snapshot is 18 MB of source without it.
upstream/open-intelligent-ui/next-env.d.ts

# Browser-harness runtime state (see docs/testing/BROWSER_HARNESS.md).
# The stamp records when the last smoke pass ran; it is machine-local.
evidence/.smoke-stamp.json

# Screenshots are full-viewport captures of a real host window: they carry
# conversation text, the sidebar's session list and sometimes the account
# name. 22 of them had to be purged from every commit in the 2026-11-04
# history rewrite, so the rule is now structural rather than remembered.
# Captures stay machine-local; their SHA-256 goes in the phase MANIFEST.
/evidence/**/*.png